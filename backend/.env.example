# Copy this file to `.env` for local development:
#   cp .env.example .env
# Then fill in the real values below. `.env` is gitignored and never committed.

DJANGO_SECRET_KEY=insecure-dev-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Local dev default is sqlite (leave unset). To point local dev at the Render
# Postgres instance instead, paste its External Database URL here.
DATABASE_URL=

GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=

FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://10.0.2.2:8080

# Get a free key at https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
