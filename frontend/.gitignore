.dart_tool/
.flutter-plugin-dependencies
build/
linux/
macos/
windows/
.packages
.pub-cache/
.pub/
*.iml

# Android platform folder is tracked (AndroidManifest.xml, build.gradle.kts
# etc. are real project config other collaborators/CI need) — only its
# generated/local build artifacts, and anything holding signing secrets,
# are ignored. The release keystore itself should live outside this repo
# entirely (see key.properties.example) — these patterns are a safety net,
# not the primary defense.
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/key.properties
android/**/GeneratedPluginRegistrant.java
android/app/build/
*.jks
*.keystore

# iOS/web platform folders are tracked too, for the same reason (custom
# URL scheme setup, index.html/manifest.json branding).
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/ServiceDefinitions.json
ios/Runner/GeneratedPluginRegistrant.*

web/generated_plugin_registrant.dart
